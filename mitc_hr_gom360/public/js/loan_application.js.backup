frappe.ui.form.on('Loan Application', {
    repayment_method: function(frm) {
        if (frm.doc.repayment_method === 'Repay Equal Principal') {
            frm.set_df_property('monthly_repayment_amount', 'reqd', 0);
            frm.set_df_property('repayment_required', 'reqd', 1);
            frm.set_value('monthly_repayment_amount', 0);
        }
    }
});
